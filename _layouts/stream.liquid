---
layout: default
---
<section class="stream-head">
  <h1 class="page-title">{{ page.title }}</h1>
  {% if page.description %}
    <p class="page-lede">{{ page.description }}</p>
  {% endif %}
  <div class="prose stream-intro">{{ content }}</div>
</section>

{% assign items = site[page.collection] | sort: 'date' | reverse %}
{% if items.size == 0 %}
  <p class="muted-note">Nothing here yet — writing in progress.</p>
{% else %}
  {% assign by_year = items | group_by_exp: 'i', 'i.date | date: "%Y"' %}
  {% for year in by_year %}
    <section class="year-group">
      <h2 class="year-label">{{ year.name }}</h2>
      <ul class="index-list">
        {% for item in year.items %}
          <li class="index-row">
            <a class="index-link" href="{{ item.url | relative_url }}">
              <time class="index-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %-d' }}</time>
              <span class="index-title">{{ item.title }}</span>
              {% if item.film -%}
                <span class="index-sub">
                  {{- item.film -}}
                  {%- if item.year %}, {{ item.year }}{% endif -%}
                </span>
              {%- endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
{% endif %}
